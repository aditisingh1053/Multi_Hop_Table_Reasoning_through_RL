# ---- local only: personal notes, papers, talk scripts, bundles (never committed) ----
local/
/*.zip
/*.log

# ---- data and model artefacts (re-created by the scripts) ----
data/
*.pt
results_smoke/
results/logs/

# ---- generated previews and intermediate renders ----
slides/**/png/
slides/architecture/architecture.html

# ---- Python / tooling ----
__pycache__/
*.pyc
.venv/
venv/
tools/
logs/

# ---- LaTeX build artefacts ----
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
